# Gemini API Key (required)
GEMINI_API_KEY="YOUR_API_KEY_HERE"

# HuggingFace token for Pyannote diarization (ICAN CLIP)
# Accept model license at: https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN="YOUR_HF_TOKEN_HERE"

# --- Legacy YouTube Viral Clipper ---
OUTPUT_DIR="./clips"
TEMP_DIR="./temp"
WHISPER_MODEL="large-v2"

# --- ICAN CLIP (Opus Clip style) ---
ICAN_OUTPUT_DIR="./ican_clips"
ICAN_TEMP_DIR="./ican_temp"
ICAN_WHISPER_MODEL="large-v3"
ICAN_GEMINI_MODEL="gemini-2.5-flash"
ICAN_YOLO_MODEL="yolov8n.pt"
ICAN_NUM_CLIPS=5
ICAN_MIN_DURATION=15
ICAN_MAX_DURATION=60

# YouTube download (optional)
# YOUTUBE_USER_AGENT="Mozilla/5.0 ..."
# YOUTUBE_COOKIES_CONTENT=""
